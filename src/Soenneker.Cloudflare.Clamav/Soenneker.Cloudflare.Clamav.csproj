<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../artifacts/openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--document-name v1 --file-name openapi --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
        <Configurations>Release;Debug</Configurations>
        <Platforms>AnyCPU</Platforms>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Clamav.Util" Version="11.0.132" />
        <PackageReference Include="Soenneker.Gen.EnumValues" Version="11.0.65" />
        <PackageReference Include="Soenneker.Librarian.R2" Version="11.0.134" />
        <PackageReference Include="Soenneker.Utils.BackgroundQueue" Version="11.0.2547" />
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2328" />
        <PackageReference Include="Soenneker.Utils.Json" Version="11.0.2769" />
        <PackageReference Include="Soenneker.Utils.Path" Version="11.0.1266" />
    </ItemGroup>

    <Target Name="RemoveWindowsScannerAssetsFromLinuxPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <RemoveDir Directories="$(PublishDir)Resources/win-x64" />
    </Target>

</Project>
