<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../artifacts/openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--document-name v1 --file-name openapi --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
        <Configurations>Release;Debug</Configurations>
        <Platforms>AnyCPU</Platforms>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Clamav.Util" Version="4.0.105" />
        <PackageReference Include="Soenneker.Gen.EnumValues" Version="4.0.62" />
        <PackageReference Include="Soenneker.Librarian.R2" Version="4.0.95" />
        <PackageReference Include="Soenneker.Utils.BackgroundQueue" Version="4.0.2540" />
        <PackageReference Include="Soenneker.Utils.File" Version="4.0.2316" />
        <PackageReference Include="Soenneker.Utils.Json" Version="4.0.2753" />
        <PackageReference Include="Soenneker.Utils.Path" Version="4.0.1261" />
    </ItemGroup>

    <Target Name="RemoveWindowsScannerAssetsFromLinuxPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <RemoveDir Directories="$(PublishDir)Resources/win-x64" />
    </Target>

</Project>
