{
  "ProjectName": "Soenneker.Cloudflare.Clamav",
  "AllowedHosts": "*",
  "Cloudflare": { "RequestResponseLogging": true },
  "Scanner": {
    "MaximumFileSize": 104857600,
    "MaximumConcurrentScans": 2,
    "TemporaryByteBudget": 268435456,
    "UploadTimeout": "00:02:00",
    "ScanTimeout": "00:05:00",
    "DefinitionUpdateInterval": "01:00:00",
    "MaximumDefinitionAge": "3.00:00:00"
  }
}
